# Smart Courier & Parcel Delivery Management System
# Production / Local Environment Variable Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GITHUB.

# Application Environment: 'development', 'testing', or 'production'
APP_ENV=development
FLASK_ENV=development

# Secret key for session encryption & CSRF tokens (generate strong key for production)
SECRET_KEY=

# Database Connection URL
# Local: leave blank for default SQLite (instance/courier.sqlite3)
# Production: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# Port for local or server binding (Render automatically provides PORT)
PORT=5000

# Optional Initial Superadmin Bootstrap (Production only - populated via Render Environment UI)
ADMIN_BOOTSTRAP_NAME=System Administrator
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
